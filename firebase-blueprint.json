{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Unified cloud workspace shared between Main Device and linked Sub Devices",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "workspaceCode": { "type": "string" },
        "orgName": { "type": "string" },
        "syncVersion": { "type": "number" },
        "updatedByUid": { "type": "string" },
        "updatedByDeviceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "workspaceCode", "orgName", "syncVersion", "updatedByUid", "updatedByDeviceId", "createdAt", "updatedAt"]
    },
    "LinkedSubDevice": {
      "title": "LinkedSubDevice",
      "description": "Authorized Sub-Device slot protected by per-device salted SHA-256 password and installation binding",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "deviceName": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "passwordHash": { "type": "string" },
        "inviteHash": { "type": "string" },
        "boundUid": { "type": "string" },
        "boundInstallationId": { "type": "string" },
        "isClaimed": { "type": "boolean" },
        "isKicked": { "type": "boolean" },
        "canAddItems": { "type": "boolean" },
        "canInward": { "type": "boolean" },
        "canDisburse": { "type": "boolean" },
        "canEditDelete": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "ownerUid", "deviceName", "passwordSalt", "passwordHash",
        "inviteHash", "boundUid", "boundInstallationId", "isClaimed", "isKicked",
        "canAddItems", "canInward", "canDisburse", "canEditDelete", "createdAt", "updatedAt"
      ]
    },
    "MemberStatus": {
      "title": "MemberStatus",
      "description": "Active membership and live permission state for a linked Sub-Device user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "workspaceId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "deviceSlotId": { "type": "string" },
        "deviceName": { "type": "string" },
        "inviteHash": { "type": "string" },
        "boundInstallationId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isKicked": { "type": "boolean" },
        "canAddItems": { "type": "boolean" },
        "canInward": { "type": "boolean" },
        "canDisburse": { "type": "boolean" },
        "canEditDelete": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "workspaceId", "ownerUid", "deviceSlotId", "deviceName",
        "inviteHash", "boundInstallationId", "isActive", "isKicked",
        "canAddItems", "canInward", "canDisburse", "canEditDelete", "joinedAt", "updatedAt"
      ]
    },
    "PairingInvite": {
      "title": "PairingInvite",
      "description": "Hash-addressed one-time per-device pairing token",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "workspaceCode": { "type": "string" },
        "ownerUid": { "type": "string" },
        "deviceSlotId": { "type": "string" },
        "deviceName": { "type": "string" },
        "canAddItems": { "type": "boolean" },
        "canInward": { "type": "boolean" },
        "canDisburse": { "type": "boolean" },
        "canEditDelete": { "type": "boolean" },
        "isUsed": { "type": "boolean" },
        "isRevoked": { "type": "boolean" },
        "boundUid": { "type": "string" },
        "boundInstallationId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "workspaceCode", "ownerUid", "deviceSlotId", "deviceName",
        "canAddItems", "canInward", "canDisburse", "canEditDelete",
        "isUsed", "isRevoked", "boundUid", "boundInstallationId", "createdAt", "updatedAt"
      ]
    },
    "CloudEntityRecord": {
      "title": "CloudEntityRecord",
      "description": "Synchronized inventory entity stored as native Firestore Map payload",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "entityType": { "type": "string" },
        "localId": { "type": "number" },
        "payload": { "type": "object" },
        "updatedByUid": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "entityType", "localId", "payload", "updatedByUid", "isDeleted", "updatedAt"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": "Workspace",
      "description": "Unified cloud workspace metadata"
    },
    "/workspaces/{workspaceId}/devices/{deviceSlotId}": {
      "schema": "LinkedSubDevice",
      "description": "Per-device credentials and permission controls managed by the Main Device"
    },
    "/workspaces/{workspaceId}/members/{memberUid}": {
      "schema": "MemberStatus",
      "description": "Live membership and access permissions bound to a Sub-Device user UID"
    },
    "/workspaces/{workspaceId}/entities/{entityId}": {
      "schema": "CloudEntityRecord",
      "description": "Synced warehouses, items, vouchers, serials, and catalogs"
    },
    "/pairing_invites/{inviteHash}": {
      "schema": "PairingInvite",
      "description": "Cryptographically hashed pairing lookup document (get-only, zero list)"
    }
  }
}
