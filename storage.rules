rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat-attachments/{conversationId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|audio/.*|text/.*|application/.*');
    }
  }
}
