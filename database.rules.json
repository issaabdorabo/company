{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "emailInvites": {
      "$inviteKey": {
        ".read": "auth != null && data.child('email').val() === auth.token.email",
        ".write": "auth != null && ((!data.exists() && root.child('workspaces').child(newData.child('workspaceId').val()).child('ownerUserId').val() === auth.uid) || (data.exists() && root.child('workspaces').child(data.child('workspaceId').val()).child('ownerUserId').val() === auth.uid))"
      }
    },
    "workspaces": {
      "$workspaceId": {
        ".read": "auth != null && (data.child('ownerUserId').val() === auth.uid || data.child('members').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUserId').val() === auth.uid) || data.child('ownerUserId').val() === auth.uid)",
        "members": {
          "$memberUid": {
            ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || $memberUid === auth.uid)",
            ".write": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || ($memberUid === auth.uid && newData.child('userId').val() === auth.uid && newData.child('active').val() === true && root.child('emailInvites').child(newData.child('inviteKey').val()).child('workspaceId').val() === $workspaceId && root.child('emailInvites').child(newData.child('inviteKey').val()).child('active').val() === true && root.child('emailInvites').child(newData.child('inviteKey').val()).child('expiresAt').val() > now))"
          }
        },
        "devices": {
          "$deviceId": {
            ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || root.child('workspaces').child($workspaceId).child('members').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || root.child('workspaces').child($workspaceId).child('members').child(auth.uid).child('active').val() === true) && newData.child('userId').val() === auth.uid"
          }
        },
        "warehouses": {
          "$warehouseId": {
            ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || root.child('workspaces').child($workspaceId).child('members').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid"
          }
        },
        "warehouseMemberships": {
          "$warehouseId": {
            "$memberUid": {
              ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || $memberUid === root.child('users').child(auth.uid).child('supabaseUserId').val())",
              ".write": "auth != null && root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid"
            }
          }
        }
      }
    }
    "workspaceEvents": {
      "$workspaceId": {
        "$deviceId": {
          ".read": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || root.child('workspaces').child($workspaceId).child('members').child(auth.uid).child('active').val() === true)",
          ".write": "auth != null && (root.child('workspaces').child($workspaceId).child('ownerUserId').val() === auth.uid || root.child('workspaces').child($workspaceId).child('members').child(auth.uid).child('active').val() === true)",
          "$eventId": {
            ".validate": "newData.hasChildren(['envelope', 'createdAt']) && newData.child('envelope').isString()"
          }
        }
      }
    },
  }
}
