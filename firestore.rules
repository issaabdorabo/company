rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function isActiveMember(workspaceId) {
      return isSignedIn() &&
        exists(memberPath(workspaceId, request.auth.uid)) &&
        get(memberPath(workspaceId, request.auth.uid)).data.isActive == true &&
        get(memberPath(workspaceId, request.auth.uid)).data.isKicked == false;
    }

    function getActiveMember(workspaceId) {
      return get(memberPath(workspaceId, request.auth.uid)).data;
    }

    // --- Schema Validators ---
    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'ownerUid', 'workspaceCode', 'orgName', 'syncVersion',
          'updatedByUid', 'updatedByDeviceId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'workspaceCode', 'orgName', 'syncVersion',
          'updatedByUid', 'updatedByDeviceId', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.workspaceCode is string && data.workspaceCode.size() >= 4 && data.workspaceCode.size() <= 24 &&
        data.orgName is string && data.orgName.size() >= 1 && data.orgName.size() <= 160 &&
        data.syncVersion is int && data.syncVersion >= 0 &&
        data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
        data.updatedByDeviceId is string && data.updatedByDeviceId.size() >= 1 && data.updatedByDeviceId.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPairingInvite(data) {
      return data.keys().hasAll([
          'workspaceId', 'workspaceCode', 'ownerUid', 'deviceSlotId', 'deviceName',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete',
          'isUsed', 'isRevoked', 'boundUid', 'boundInstallationId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'workspaceId', 'workspaceCode', 'ownerUid', 'deviceSlotId', 'deviceName',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete',
          'isUsed', 'isRevoked', 'boundUid', 'boundInstallationId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.workspaceId) &&
        data.workspaceCode is string && data.workspaceCode.size() >= 4 && data.workspaceCode.size() <= 24 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidId(data.deviceSlotId) &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.canAddItems is bool &&
        data.canInward is bool &&
        data.canDisburse is bool &&
        data.canEditDelete is bool &&
        data.isUsed is bool &&
        data.isRevoked is bool &&
        data.boundUid is string && data.boundUid.size() <= 128 &&
        data.boundInstallationId is string && data.boundInstallationId.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDeviceSlot(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'ownerUid', 'deviceName', 'passwordSalt', 'passwordHash',
          'inviteHash', 'boundUid', 'boundInstallationId', 'isClaimed', 'isKicked',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'workspaceId', 'ownerUid', 'deviceName', 'passwordSalt', 'passwordHash',
          'inviteHash', 'boundUid', 'boundInstallationId', 'isClaimed', 'isKicked',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'createdAt', 'updatedAt'
        ]) &&
        data.workspaceId == workspaceId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 64 &&
        data.passwordHash is string && data.passwordHash.size() == 64 &&
        data.inviteHash is string && data.inviteHash.size() == 64 &&
        data.boundUid is string && data.boundUid.size() <= 128 &&
        data.boundInstallationId is string && data.boundInstallationId.size() <= 128 &&
        data.isClaimed is bool &&
        data.isKicked is bool &&
        data.canAddItems is bool &&
        data.canInward is bool &&
        data.canDisburse is bool &&
        data.canEditDelete is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMember(data, workspaceId, memberUid) {
      return data.keys().hasAll([
          'uid', 'workspaceId', 'ownerUid', 'deviceSlotId', 'deviceName',
          'inviteHash', 'boundInstallationId', 'isActive', 'isKicked',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'joinedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'workspaceId', 'ownerUid', 'deviceSlotId', 'deviceName',
          'inviteHash', 'boundInstallationId', 'isActive', 'isKicked',
          'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'joinedAt', 'updatedAt'
        ]) &&
        data.uid == memberUid &&
        data.workspaceId == workspaceId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidId(data.deviceSlotId) &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.inviteHash is string && data.inviteHash.size() == 64 &&
        data.boundInstallationId is string && data.boundInstallationId.size() >= 8 && data.boundInstallationId.size() <= 128 &&
        data.isActive is bool &&
        data.isKicked is bool &&
        data.canAddItems is bool &&
        data.canInward is bool &&
        data.canDisburse is bool &&
        data.canEditDelete is bool &&
        data.joinedAt is timestamp && data.joinedAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudEntity(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'entityType', 'localId', 'payload', 'updatedByUid', 'isDeleted', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'workspaceId', 'entityType', 'localId', 'payload', 'updatedByUid', 'isDeleted', 'updatedAt'
        ]) &&
        data.workspaceId == workspaceId &&
        data.entityType is string &&
        data.entityType in [
          'warehouse', 'item', 'beneficiary', 'supplier', 'party',
          'category', 'unit', 'association', 'adjustment', 'voucher', 'voucher_item', 'serial'
        ] &&
        data.localId is int && data.localId >= 0 &&
        data.payload is map &&
        data.updatedByUid == request.auth.uid &&
        data.isDeleted is bool &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function memberHasEntityPermission(workspaceId, data, isUpdate) {
      let member = getActiveMember(workspaceId);
      return (!data.isDeleted || member.canEditDelete == true) &&
        (!isUpdate || member.canEditDelete == true || member.canAddItems == true || member.canInward == true || member.canDisburse == true) &&
        (
          (data.entityType in ['warehouse', 'item', 'beneficiary', 'supplier', 'party', 'category', 'unit', 'association', 'adjustment', 'serial'] &&
            member.canAddItems == true) ||
          (data.entityType in ['voucher', 'voucher_item'] && (
            ((data.payload.voucherType == 'INWARD') && member.canInward == true) ||
            ((data.payload.voucherType != 'INWARD') && member.canDisburse == true)
          ))
        );
    }

    // --- Collection Rules ---

    // 1. Pairing invites: hashed with SHA256(workspaceCode + password); get-only, never listable
    match /pairing_invites/{inviteHash} {
      allow get: if isSignedIn() && isValidId(inviteHash);
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(inviteHash) &&
        isValidPairingInvite(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        isWorkspaceOwner(incoming().workspaceId) &&
        incoming().isUsed == false &&
        incoming().isRevoked == false;

      allow update: if isSignedIn() &&
        isValidId(inviteHash) &&
        isValidPairingInvite(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().deviceSlotId == existing().deviceSlotId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Owner updates permissions or revokes invite
          (existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isRevoked', 'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'updatedAt'
            ])) ||
          // Sub-device claims unclaimed (or own previously bound) invite atomically
          (existing().isRevoked == false &&
            (existing().isUsed == false || existing().boundUid == request.auth.uid) &&
            incoming().isUsed == true &&
            incoming().isRevoked == false &&
            incoming().boundUid == request.auth.uid &&
            incoming().boundInstallationId.size() >= 8 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isUsed', 'boundUid', 'boundInstallationId', 'updatedAt'
            ]))
        );

      allow delete: if isSignedIn() && isValidId(inviteHash) && existing().ownerUid == request.auth.uid;
    }

    // 2. Unified Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) &&
        (existing().ownerUid == request.auth.uid || isActiveMember(workspaceId));

      // Owner-scoped query for cloud recovery after reinstall
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedByUid == request.auth.uid;

      allow update: if isSignedIn() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedByUid == request.auth.uid &&
        (
          existing().ownerUid == request.auth.uid ||
          (isActiveMember(workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'syncVersion', 'updatedByUid', 'updatedByDeviceId', 'updatedAt'
            ]))
        );

      allow delete: if isSignedIn() && isValidId(workspaceId) && existing().ownerUid == request.auth.uid;

      // 3. Linked Sub-Devices under Workspace
      match /devices/{deviceSlotId} {
        allow get: if isSignedIn() && isValidId(deviceSlotId) &&
          (existing().ownerUid == request.auth.uid || existing().boundUid == request.auth.uid);

        allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(deviceSlotId) &&
          isValidDeviceSlot(incoming(), workspaceId) &&
          incoming().ownerUid == request.auth.uid &&
          isWorkspaceOwner(workspaceId) &&
          incoming().isClaimed == false &&
          incoming().isKicked == false;

        allow update: if isSignedIn() &&
          isValidId(deviceSlotId) &&
          isValidDeviceSlot(incoming(), workspaceId) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          (
            (existing().ownerUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'deviceName', 'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'isKicked', 'updatedAt'
              ])) ||
            (existing().isKicked == false &&
              (existing().isClaimed == false || existing().boundUid == request.auth.uid) &&
              incoming().isClaimed == true &&
              incoming().isKicked == false &&
              incoming().boundUid == request.auth.uid &&
              incoming().boundInstallationId.size() >= 8 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'isClaimed', 'boundUid', 'boundInstallationId', 'updatedAt'
              ]) &&
              existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)))
          );

        allow delete: if isSignedIn() && isValidId(deviceSlotId) && isWorkspaceOwner(workspaceId);
      }

      // 4. Active Members & Permissions (real-time kick/permission status)
      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(memberUid) &&
          (request.auth.uid == memberUid || existing().ownerUid == request.auth.uid);

        allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(memberUid) &&
          request.auth.uid == memberUid &&
          isValidMember(incoming(), workspaceId, memberUid) &&
          incoming().isActive == true &&
          incoming().isKicked == false &&
          exists(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)) &&
          get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.workspaceId == workspaceId &&
          get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.deviceSlotId == incoming().deviceSlotId &&
          get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.isRevoked == false &&
          (get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.isUsed == false ||
            get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.boundUid == request.auth.uid) &&
          incoming().canAddItems == get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.canAddItems &&
          incoming().canInward == get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.canInward &&
          incoming().canDisburse == get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.canDisburse &&
          incoming().canEditDelete == get(/databases/$(database)/documents/pairing_invites/$(incoming().inviteHash)).data.canEditDelete;

        allow update: if isSignedIn() &&
          isValidId(memberUid) &&
          isValidMember(incoming(), workspaceId, memberUid) &&
          incoming().uid == existing().uid &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().joinedAt == existing().joinedAt &&
          isWorkspaceOwner(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isActive', 'isKicked', 'canAddItems', 'canInward', 'canDisburse', 'canEditDelete', 'deviceName', 'updatedAt'
          ]);

        allow delete: if isSignedIn() && isValidId(memberUid) && isWorkspaceOwner(workspaceId);
      }

      // 5. Synced Inventory Entities
      match /entities/{entityId} {
        allow get, list: if isSignedIn() &&
          (isWorkspaceOwner(workspaceId) || isActiveMember(workspaceId));

        allow create: if isSignedIn() &&
          isValidId(entityId) &&
          isValidCloudEntity(incoming(), workspaceId) &&
          (isWorkspaceOwner(workspaceId) ||
            (isActiveMember(workspaceId) && memberHasEntityPermission(workspaceId, incoming(), false)));

        allow update: if isSignedIn() &&
          isValidId(entityId) &&
          isValidCloudEntity(incoming(), workspaceId) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().entityType == existing().entityType &&
          incoming().localId == existing().localId &&
          (isWorkspaceOwner(workspaceId) ||
            (isActiveMember(workspaceId) && memberHasEntityPermission(workspaceId, incoming(), true)));

        allow delete: if isSignedIn() &&
          isValidId(entityId) &&
          (isWorkspaceOwner(workspaceId) ||
            (isActiveMember(workspaceId) && getActiveMember(workspaceId).canEditDelete == true));
      }
    }
  }
}
