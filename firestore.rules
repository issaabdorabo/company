rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function recordPath(workspaceId, recordId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/records/$(recordId);
    }

    function isOwner(workspaceId) {
      return signedIn()
        && exists(workspacePath(workspaceId))
        && get(workspacePath(workspaceId)).data.ownerUid == request.auth.uid;
    }

    function isActiveMember(workspaceId) {
      return signedIn() && (
        isOwner(workspaceId)
        || (
          exists(memberPath(workspaceId, request.auth.uid))
          && get(memberPath(workspaceId, request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    function memberPermissions(workspaceId) {
      return get(memberPath(workspaceId, request.auth.uid)).data.permissions;
    }

    function hasWarehousePermission(workspaceId, warehouseId, permissionList, globalPermission) {
      let p = memberPermissions(workspaceId);
      return p != null && (
        (p.canViewAllWarehouses == true && p[globalPermission] == true)
        || (p[permissionList] is list && warehouseId in p[permissionList])
      );
    }

    function canCreateVoucher(workspaceId, voucherPayload) {
      let voucherType = voucherPayload.voucherType;
      let sourceId = voucherPayload.sourceWarehouseId;
      let destinationId = voucherPayload.destinationWarehouseId;
      return voucherType == 'INWARD'
        ? hasWarehousePermission(workspaceId, destinationId, 'canInwardWarehouseIds', 'canInward')
        : voucherType == 'TRANSFER'
          ? hasWarehousePermission(workspaceId, sourceId, 'canTransferWarehouseIds', 'canTransfer')
            && hasWarehousePermission(workspaceId, destinationId, 'canTransferWarehouseIds', 'canTransfer')
          : hasWarehousePermission(workspaceId, sourceId, 'canDisburseWarehouseIds', 'canDisburse');
    }

    function canEditOrDeleteVoucher(workspaceId, voucherPayload, deleting) {
      let p = memberPermissions(workspaceId);
      let isSupply = voucherPayload.voucherType == 'INWARD';
      return deleting
        ? (isSupply ? p.canDeleteSupplyVoucher == true : p.canDeleteIssueVoucher == true)
        : (isSupply ? p.canEditSupplyVoucher == true : p.canEditIssueVoucher == true);
    }

    function canWriteRecord(workspaceId, recordId, data, deleting) {
      let p = memberPermissions(workspaceId);
      let kind = data.entityType;
      let payload = data.payload;
      let existsBefore = exists(recordPath(workspaceId, recordId));

      return isOwner(workspaceId) || (
        p != null && (
          kind == 'warehouse'
            ? (p.canAddItems == true || p.canEditDelete == true)
          : kind == 'item'
            ? (deleting
                ? p.canDeleteItem == true
                : (existsBefore ? p.canEditCatalogItems == true : p.canAddItems == true))
          : kind == 'voucher'
            ? (deleting
                ? canEditOrDeleteVoucher(workspaceId, resource.data.payload, true)
                : (canCreateVoucher(workspaceId, payload)
                    && (!existsBefore || canEditOrDeleteVoucher(workspaceId, payload, false))))
          : kind == 'voucher_item'
            ? (
                exists(recordPath(workspaceId, 'voucher_' + string(payload.voucherId)))
                  || existsAfter(recordPath(workspaceId, 'voucher_' + string(payload.voucherId)))
              )
              && (
                deleting
                  ? canEditOrDeleteVoucher(
                      workspaceId,
                      exists(recordPath(workspaceId, 'voucher_' + string(payload.voucherId)))
                        ? get(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload
                        : getAfter(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload,
                      true
                    )
                  : (
                      canCreateVoucher(
                        workspaceId,
                        exists(recordPath(workspaceId, 'voucher_' + string(payload.voucherId)))
                          ? get(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload
                          : getAfter(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload
                      )
                      && (!existsBefore || canEditOrDeleteVoucher(
                        workspaceId,
                        exists(recordPath(workspaceId, 'voucher_' + string(payload.voucherId)))
                          ? get(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload
                          : getAfter(recordPath(workspaceId, 'voucher_' + string(payload.voucherId))).data.payload,
                        false
                      ))
                    )
              )
          : kind == 'adjustment'
            ? hasWarehousePermission(workspaceId, payload.warehouseId, 'canAdjustWarehouseIds', 'canAdjust')
          : kind == 'association'
            ? (deleting
                ? (hasWarehousePermission(workspaceId, payload.warehouseId, 'canDeleteItemWarehouseIds', 'canDeleteItem')
                    || hasWarehousePermission(workspaceId, payload.warehouseId, 'canEditInventoryWarehouseIds', 'canEditInventory'))
                : (p.canAddItems == true
                    || hasWarehousePermission(workspaceId, payload.warehouseId, 'canEditInventoryWarehouseIds', 'canEditInventory')))
          : kind == 'serial'
            ? hasWarehousePermission(workspaceId, payload.warehouseId, 'canEditInventoryWarehouseIds', 'canEditInventory')
          : kind == 'beneficiary' || kind == 'supplier' || kind == 'party'
            ? (p.canAddItems == true || p.canEditDelete == true)
          : kind == 'category' || kind == 'unit' || kind == 'smaller_unit' || kind == 'item_status'
            ? (p.canAddItems == true || p.canEditCatalogItems == true)
          : false
        )
      );
    }

    function validPairingInvite(workspaceId) {
      let invitePath = /databases/$(database)/documents/workspaces/$(workspaceId)/pairingInvites/$(request.resource.data.inviteHash);
      return request.resource.data.inviteHash is string
        && exists(invitePath)
        && get(invitePath).data.workspaceId == workspaceId
        && get(invitePath).data.status == 'PENDING'
        && get(invitePath).data.expiresAt > request.time
        && get(invitePath).data.deviceSlotId == request.resource.data.deviceSlotId
        && get(invitePath).data.deviceName == request.resource.data.deviceName
        && get(invitePath).data.permissions == request.resource.data.permissions;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.workspaceId == workspaceId;
      allow get, list: if isActiveMember(workspaceId);
      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{memberUid} {
        allow get, list: if isOwner(workspaceId)
          || (signedIn() && request.auth.uid == memberUid);
        allow create: if (
          signedIn()
          && request.auth.uid == memberUid
          && request.resource.data.uid == memberUid
          && request.resource.data.role == 'SUB'
          && request.resource.data.status == 'ACTIVE'
          && validPairingInvite(workspaceId)
        ) || (
          isOwner(workspaceId)
          && memberUid == request.auth.uid
          && request.resource.data.role == 'MAIN'
          && request.resource.data.status == 'ACTIVE'
        );
        allow update: if isOwner(workspaceId)
          || (
            signedIn()
            && request.auth.uid == memberUid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['online', 'lastSeenAt', 'updatedAt', 'installationId'])
          );
        allow delete: if isOwner(workspaceId);
      }

      match /pairingInvites/{inviteHash} {
        allow get: if isOwner(workspaceId)
          || (
            signedIn()
            && resource.data.status == 'PENDING'
            && resource.data.expiresAt > request.time
          );
        allow list: if isOwner(workspaceId);
        allow create, delete: if isOwner(workspaceId);
        allow update: if isOwner(workspaceId)
          || (
            signedIn()
            && resource.data.status == 'PENDING'
            && resource.data.expiresAt > request.time
            && request.resource.data.status == 'CLAIMED'
            && request.resource.data.claimedByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'claimedByUid', 'claimedAt'])
          );
      }

      match /records/{recordId} {
        allow read: if isActiveMember(workspaceId);
        allow create: if isActiveMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && canWriteRecord(workspaceId, recordId, request.resource.data, false);
        allow update: if isActiveMember(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && canWriteRecord(
            workspaceId,
            recordId,
            request.resource.data.isDeleted == true ? resource.data : request.resource.data,
            request.resource.data.isDeleted == true
          );
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read, create, update: if isActiveMember(workspaceId);
        allow delete: if false;
      }

      match /conflicts/{conflictId} {
        allow read, create, update: if isActiveMember(workspaceId);
        allow delete: if false;
      }
    }
  }
}
